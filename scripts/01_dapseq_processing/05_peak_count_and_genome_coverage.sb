#!/usr/bin/env bash
#SBATCH --job-name=dapseq_peak_cov
#SBATCH --output=dapseq_peak_cov.%j.out
#SBATCH --error=dapseq_peak_cov.%j.err
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G

# Submit from the repository folder with:
# sbatch scripts/01_dapseq_processing/05_peak_count_and_genome_coverage.sb

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/00_config.sh"

# Load bedtools as appropriate for your system.
# module purge
# module load BEDTools
# conda activate bedtools

BED_DIR="${OUT_DIR}/peaks_bed_for_chipseeker"
COV_DIR="${OUT_DIR}/peak_coverage"
mkdir -p "${COV_DIR}"

if [[ ! -d "${BED_DIR}" ]]; then
    echo "ERROR: BED_DIR does not exist. Run 04_prepare_peak_beds_for_chipseeker.sh first." >&2
    exit 1
fi

# Per-TF peak counts and total peak bp before cross-TF merge.
echo -e "geneID\tpeak_count\ttotal_peak_bp" > "${COV_DIR}/per_tf_peak_counts.tsv"
for bed in "${BED_DIR}"/*.bed; do
    gene="$(basename "${bed}" .bed)"
    peak_count=$(wc -l < "${bed}")
    total_bp=$(awk '{sum += ($3 - $2)} END {print sum+0}' "${bed}")
    echo -e "${gene}\t${peak_count}\t${total_bp}" >> "${COV_DIR}/per_tf_peak_counts.tsv"
done

# Merge all peak intervals across all TFs.
cat "${BED_DIR}"/*.bed \
    | awk -v OFS='\t' '{print $1,$2,$3}' \
    | sort -k1,1 -k2,2n \
    > "${COV_DIR}/all_peaks.bed"

bedtools merge -i "${COV_DIR}/all_peaks.bed" > "${COV_DIR}/all_peaks_merged.bed"

awk -v OFS='\t' '{print $1,$2,$3,$3-$2}' "${COV_DIR}/all_peaks_merged.bed" \
    > "${COV_DIR}/all_peaks_merged_lengthAdded.bed"

merged_intervals=$(wc -l < "${COV_DIR}/all_peaks_merged.bed")
merged_bp=$(awk '{sum += ($3 - $2)} END {print sum+0}' "${COV_DIR}/all_peaks_merged.bed")
coverage_pct=$(awk -v bp="${merged_bp}" -v gs="${GENOME_SIZE}" 'BEGIN {printf "%.4f", (bp/gs)*100}')

echo -e "metric\tvalue" > "${COV_DIR}/genome_coverage_summary.tsv"
echo -e "merged_peak_intervals\t${merged_intervals}" >> "${COV_DIR}/genome_coverage_summary.tsv"
echo -e "merged_peak_bp\t${merged_bp}" >> "${COV_DIR}/genome_coverage_summary.tsv"
echo -e "genome_size_bp\t${GENOME_SIZE}" >> "${COV_DIR}/genome_coverage_summary.tsv"
echo -e "genome_coverage_percent\t${coverage_pct}" >> "${COV_DIR}/genome_coverage_summary.tsv"

cat "${COV_DIR}/genome_coverage_summary.tsv"
