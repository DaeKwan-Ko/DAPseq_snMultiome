#!/usr/bin/env bash
#SBATCH --job-name=dapseq_mbs_all
#SBATCH --output=dapseq_mbs_all.%j.out
#SBATCH --error=dapseq_mbs_all.%j.err
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G

# Submit from the repository folder with:
# sbatch scripts/01_dapseq_processing/02_multibam_summary_all.sb

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/00_config.sh"

# Load modules or activate conda environment as appropriate for your system.
# Example for MSU HPCC; edit as needed.
# module purge
# module load deepTools
# conda activate deeptools

mkdir -p "${OUT_DIR}/deeptools/all"

if [[ ! -f "${OUT_DIR}/filelists/all_bams.space.txt" ]]; then
    echo "ERROR: BAM file list not found. Run 01_generate_bam_filelists.sh first." >&2
    exit 1
fi

BAMS=$(cat "${OUT_DIR}/filelists/all_bams.space.txt")
LABELS=$(cat "${OUT_DIR}/filelists/all_labels.space.txt")

multiBamSummary bins \
    --bamfiles ${BAMS} \
    --labels ${LABELS} \
    --binSize "${BIN_SIZE}" \
    --numberOfProcessors "${THREADS}" \
    --outFileName "${OUT_DIR}/deeptools/all/all_TFs_bin${BIN_SIZE}.npz" \
    --outRawCounts "${OUT_DIR}/deeptools/all/all_TFs_bin${BIN_SIZE}.raw_counts.tsv"

plotCorrelation \
    -in "${OUT_DIR}/deeptools/all/all_TFs_bin${BIN_SIZE}.npz" \
    --corMethod pearson \
    --skipZeros \
    --plotTitle "DAP-seq Pearson correlation: all TFs" \
    --whatToPlot heatmap \
    --colorMap RdYlBu \
    --plotNumbers \
    --outFileCorMatrix "${OUT_DIR}/deeptools/all/all_TFs_pearson_correlation.tsv" \
    --plotFile "${OUT_DIR}/deeptools/all/all_TFs_pearson_correlation.pdf"
